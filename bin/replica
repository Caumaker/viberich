#!/usr/bin/env node
// replica: documento local em blocos com id fixo e histórico de versões; o usuário comenta (bloco ou seleção) e
// a sessão responde e edita em tempo real (SSE). Nada é apagado: remover = esconder; restaurar = nova versão.
//   servir [porta]                        servidor em 127.0.0.1 (padrão 7743): http://localhost:7743/<slug>
//   publicar <slug> <arquivo.md>          cria o documento a partir do .md (só se ainda não existir; use --forcar para recriar)
//   blocos <slug>                         lista os blocos (id, versão, começo do texto)
//   bloco <slug> <id>                     imprime o markdown atual do bloco
//   editar <slug> <id> <@arq|texto> [--comentario id] [--motivo "..."]   nova versão do bloco (e aviso no fio)
//   inserir <slug> <depoisDeId> <@arq|texto> [--comentario id] [--motivo "..."]   bloco novo depois de outro
//   remover <slug> <id> [--comentario id] [--motivo "..."]   esconde o bloco (fica no histórico)
//   pendentes [slug] | responder <id> <texto|@arq> | resolver <id> | esperar [segundos]
//   escolhas <slug>                       estado das perguntas de escolha (o que o usuário marcou em cada uma)
// Escolhas no markdown (o usuário marca em vez de escrever): lista com itens
//   - ( ) opção       escolha única (radio)      - (*) já marcada
//   - [ ] opção       múltipla (checkbox)        - [x] já marcada
//   - {off} opção     liga/desliga (switch)      - {on} já ligada
// Cada marcação vira mensagem do usuário no fio da pergunta: aparece em pendentes e acorda o esperar.
const fs = require('fs'), path = require('path'), http = require('http'), os = require('os');
// pasta dos documentos: REPLICA_DIR ou ~/.replica/docs
const RAIZ = process.env.REPLICA_DIR || path.join(os.homedir(), '.replica', 'docs');
const PORTA = Number(process.env.REPLICA_PORT) || 7743;
const abrirNoSO = (alvo, revelar) => { const cp = require('child_process'); if (process.platform === 'darwin') cp.execFile('open', revelar ? ['-R', alvo] : [alvo]); else if (process.platform === 'win32') cp.execFile('explorer', revelar ? ['/select,', alvo] : [alvo]); else cp.execFile('xdg-open', [revelar ? path.dirname(alvo) : alvo]); };
const agora = () => new Date().toISOString();
const novoId = (p = '') => p + Math.random().toString(36).slice(2, 8) + Date.now().toString(36).slice(-3);
const dir = (s) => path.join(RAIZ, s);
const lerJ = (f, d) => { try { return JSON.parse(fs.readFileSync(f, 'utf8')); } catch (e) { return d; } };
const lerD = (s) => lerJ(path.join(dir(s), 'doc.json'), null);
const gravarD = (s, d) => fs.writeFileSync(path.join(dir(s), 'doc.json'), JSON.stringify(d, null, 1));
const lerC = (s) => lerJ(path.join(dir(s), 'comentarios.json'), []);
const gravarC = (s, c) => fs.writeFileSync(path.join(dir(s), 'comentarios.json'), JSON.stringify(c, null, 1));
const lerE = (s) => lerJ(path.join(dir(s), 'escolhas.json'), {});
const gravarE = (s, e) => fs.writeFileSync(path.join(dir(s), 'escolhas.json'), JSON.stringify(e, null, 1));
const RE_OP = /^- (\(( |\*|x)\)|\[( |x|X)\]|\{(on|off)\}) +(.*)$/;
// itens de escolha de um bloco: [{tipo: radio|check|switch, pre: bool, texto}]
const opcoes = (md) => md.split('\n').map((l) => l.match(RE_OP)).filter(Boolean).map((m) => ({ tipo: m[1][0] === '(' ? 'radio' : m[1][0] === '[' ? 'check' : 'switch', pre: /\*|x|X|on/.test(m[1]), texto: m[5] }));
const limpo = (t) => String(t).replace(/\*\*|`/g, '').replace(/\[([^\]]+)\]\([^)]*\)/g, '$1').trim();
const slugs = () => fs.existsSync(RAIZ) ? fs.readdirSync(RAIZ).filter((d) => fs.existsSync(path.join(RAIZ, d, 'doc.json'))) : [];
const esc = (t) => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const inline = (t) => esc(t).replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>').replace(/`([^`]+)`/g, '<code>$1</code>');

// divide o markdown em blocos (um parágrafo, uma lista, uma tabela, um destaque, um título, um svg)
function dividir(md) {
  const L = md.replace(/\r/g, '').split('\n'); const B = []; let i = 0;
  while (i < L.length) {
    const l = L[i]; if (!l.trim()) { i++; continue; }
    let j = i + 1;
    if (l.startsWith('```')) { while (j < L.length && !L[j].startsWith('```')) j++; j++; }
    else if (/^#{1,3} /.test(l)) j = i + 1;
    else if (l.startsWith('<')) { while (j < L.length && L[j].trim()) j++; }
    else if (l.startsWith('> ')) { while (j < L.length && L[j].startsWith('>')) j++; }
    else if (l.startsWith('|')) { while (j < L.length && L[j].startsWith('|')) j++; }
    else if (/^(- |\d+\. )/.test(l)) { while (j < L.length && /^(- |\d+\. |    )/.test(L[j])) j++; }
    else { while (j < L.length && L[j].trim() && !/^(#|\||- |\d+\. |> |<)/.test(L[j])) j++; }
    B.push(L.slice(i, j).join('\n')); i = j;
  }
  return B;
}
function render(md) {
  const L = md.split('\n'); const l = L[0]; let m;
  if (l.startsWith('```chart')) return { tipo: 'grafico', html: `<div class="fig grafico"><canvas data-chart='${esc(L.slice(1, -1).join('\n')).replace(/'/g, '&#39;')}'></canvas></div>` };
  if (l.startsWith('```mermaid')) return { tipo: 'mermaid', html: `<div class="fig"><pre class="mermaid">${esc(L.slice(1, -1).join('\n'))}</pre></div>` };
  if (l.startsWith('```')) return { tipo: 'codigo', html: `<pre class="fig" style="white-space:pre-wrap">${esc(L.slice(1, -1).join('\n'))}</pre>` };
  if (l.startsWith('<')) return { tipo: 'fig', html: md };
  if ((m = l.match(/^(#{1,3}) (.*)/))) return { tipo: 'h' + m[1].length, html: `<h${m[1].length}>${inline(m[2])}</h${m[1].length}>` };
  if (l.startsWith('> ')) return { tipo: 'destaque', html: `<div class="destaque">${L.map((x) => x.replace(/^> ?/, '')).map((x) => /^\s+(\d+\.|-) /.test(x) ? `<div class="li2">${inline(x.trim().replace(/^- /, ''))}</div>` : x.startsWith('- ') ? `<div class="li">${inline(x.slice(2))}</div>` : (x.trim() ? `<p>${inline(x)}</p>` : '')).join('')}</div>` };
  if (l.startsWith('|')) { const cel = (r) => r.trim().replace(/^\||\|$/g, '').split('|').map((c) => c.trim()); const h = cel(L[0]); return { tipo: 'tabela', html: `<div class="tabela"><table><thead><tr>${h.map((x) => `<th>${inline(x)}</th>`).join('')}</tr></thead><tbody>${L.slice(2).map((r) => `<tr>${cel(r).map((c) => `<td>${inline(c)}</td>`).join('')}</tr>`).join('')}</tbody></table></div>` }; }
  if (RE_OP.test(l)) { const ops = opcoes(md); return { tipo: 'escolha', html: `<div class="escolhas" contenteditable="false">${ops.map((o, k) => `<label class="op op-${o.tipo}"><input type="${o.tipo === 'radio' ? 'radio' : 'checkbox'}" data-i="${k}"${o.pre ? ' data-pre="1"' : ''}>${o.tipo === 'switch' ? '<span class="sw"></span>' : ''}<span class="tx">${inline(o.texto)}</span></label>`).join('')}</div>` }; }
  if (/^(- |\d+\. )/.test(l)) { const ord = /^\d+\. /.test(l); const it = []; for (const x of L) { if (x.startsWith('    ') && it.length) it[it.length - 1] += '<br>' + inline(x.trim().replace(/^- /, '')); else if (x.trim()) it.push(inline(x.replace(/^(- |\d+\. )/, ''))); } return { tipo: 'lista', html: `<${ord ? 'ol' : 'ul'}>${it.map((x) => `<li>${x}</li>`).join('')}</${ord ? 'ol' : 'ul'}>` }; }
  return { tipo: 'p', html: `<p>${inline(L.join(' '))}</p>` };
}
function novaVersao(blk, md, autor, motivo, comentario) {
  const v = (blk.versoes.at(-1)?.v || 0) + 1;
  blk.versoes.push({ v, md: md.trim(), em: agora(), autor, motivo: motivo || '', comentario: comentario || '' });
  return v;
}
function avisarFio(s, comentario, texto) {
  if (!comentario) return; const C = lerC(s); const c = C.find((x) => x.id === comentario);
  if (c) { c.msgs.push({ id: novoId('m'), de: 'claude', tipo: 'edicao', texto, em: agora() }); gravarC(s, C); }
}
// título da pergunta: o h3 (ou h2) logo acima da lista de escolhas
function tituloPergunta(d, id) {
  const vis = d.blocos.filter((b) => !b.oculto); const k = vis.findIndex((b) => b.id === id);
  for (let i = k - 1; i >= 0 && i >= k - 4; i--) { const md = vis[i].versoes.at(-1).md; const m = md.match(/^#{2,3} (.*)/); if (m) return limpo(m[1]); if (RE_OP.test(md)) break; }
  return '';
}
function escolher(s, bloco, marcados) {
  const d = lerD(s); const blk = d.blocos.find((x) => x.id === bloco); if (!blk) return;
  const ops = opcoes(blk.versoes.at(-1).md); marcados = [...new Set(marcados)].filter((k) => k < ops.length).sort((a, b) => a - b);
  const E = lerE(s); E[bloco] = { marcados, rotulos: marcados.map((k) => limpo(ops[k].texto)), v: blk.versoes.at(-1).v, em: agora() }; gravarE(s, E);
  const tit = tituloPergunta(d, bloco);
  const txt = (tit ? tit + ': ' : '') + (marcados.length ? marcados.map((k) => (ops[k].tipo === 'switch' ? 'ligado: ' : '') + limpo(ops[k].texto)).join(' | ') : 'desmarquei tudo');
  const C = lerC(s); let c = C.find((x) => x.bloco === bloco && x.tipo === 'escolha' && !x.resolvido);
  const msg = { id: novoId('m'), de: 'dono', tipo: 'escolha', texto: txt, em: agora() };
  if (!c) { c = { id: novoId('c'), tipo: 'escolha', bloco, trecho: tit, segmentos: [], blocoV: blk.versoes.at(-1).v, resolvido: false, msgs: [msg] }; C.push(c); }
  else { const ult = c.msgs.filter((m) => m.de !== 'sistema').at(-1); if (ult && ult.de === 'dono' && ult.tipo === 'escolha') Object.assign(ult, { texto: txt, em: msg.em }); else c.msgs.push(msg); }
  gravarC(s, C);
}
const visao = (s) => { const d = lerD(s); return { titulo: d.titulo, origem: d.origem || '', blocos: d.blocos.filter((b) => !b.oculto).map((b) => { const ult = b.versoes.at(-1); return { id: b.id, v: ult.v, em: ult.em, autor: ult.autor, ...render(ult.md) }; }) }; };

const PAGINA_F = ['doc-comentavel.html', 'replica.html'].map((n) => path.join(__dirname, n)).find((f) => fs.existsSync(f));
function servir(porta) {
  const ouvintes = new Map(); // slug -> Set(res)
  const avisar = (s) => { for (const r of ouvintes.get(s) || []) r.write(`data: mudou\n\n`); };
  const vistos = new Set();
  const vigiar = () => { for (const s of slugs()) { if (vistos.has(s)) continue; vistos.add(s); for (const f of ['doc.json', 'comentarios.json', 'escolhas.json']) fs.watchFile(path.join(dir(s), f), { interval: 700 }, () => avisar(s)); } };
  vigiar(); setInterval(vigiar, 5000);
  http.createServer((req, res) => {
    const u = new URL(req.url, 'http://x'); const p = u.pathname.split('/').filter(Boolean);
    const json = (o, st = 200) => { res.writeHead(st, { 'content-type': 'application/json; charset=utf-8' }); res.end(JSON.stringify(o)); };
    const corpo = () => new Promise((ok) => { let d = ''; req.on('data', (c) => (d += c)); req.on('end', () => { try { ok(JSON.parse(d || '{}')); } catch (e) { ok({}); } }); });
    if (p[0] === 'api' && slugs().includes(p[1])) {
      const s = p[1];
      if (p[2] === 'eventos') { res.writeHead(200, { 'content-type': 'text/event-stream', 'cache-control': 'no-cache', connection: 'keep-alive' }); res.write('data: ola\n\n'); if (!ouvintes.has(s)) ouvintes.set(s, new Set()); ouvintes.get(s).add(res); req.on('close', () => ouvintes.get(s).delete(res)); return; }
      if (p[2] === 'doc') return json(visao(s));
      if (p[2] === 'md') { res.writeHead(200, { 'content-type': 'text/plain; charset=utf-8' }); return res.end(lerD(s).blocos.filter((b) => !b.oculto).map((b) => b.versoes.at(-1).md).join('\n\n') + '\n'); }
      if (p[2] === 'comentarios') return json(lerC(s));
      if (p[2] === 'escolhas') return json(lerE(s));
      if (p[2] === 'historico') { const b = lerD(s).blocos.find((x) => x.id === u.searchParams.get('b')); return json(b ? b.versoes.map((v) => ({ ...v, html: render(v.md).html })) : []); }
      return corpo().then((b) => {
        const anexos = Array.isArray(b.anexos) ? b.anexos.filter((a) => a && a.url).slice(0, 10) : [];
        if (p[2] === 'anexo' && b.dados) { const m = String(b.dados).match(/^data:image\/(png|jpe?g|gif|webp);base64,(.+)$/); if (!m) return json({ erro: 'formato' }); const ad = path.join(dir(s), 'anexos'); fs.mkdirSync(ad, { recursive: true }); const nome = `print-${new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-')}-${novoId()}.${m[1].replace('jpeg', 'jpg')}`; fs.writeFileSync(path.join(ad, nome), Buffer.from(m[2], 'base64')); return json({ url: `/a/${s}/${nome}`, caminho: path.join(ad, nome) }); }
        if (p[2] === 'comentar' && (b.texto || anexos.length)) { const C = lerC(s); C.push({ id: novoId('c'), bloco: b.bloco, trecho: b.trecho || '', segmentos: Array.isArray(b.segmentos) ? b.segmentos.slice(0, 40) : [], blocoV: b.blocoV || 0, resolvido: false, msgs: [{ id: novoId('m'), de: 'dono', texto: String(b.texto || '').trim(), anexos, cita: b.cita || null, em: agora() }] }); gravarC(s, C); }
        else if (p[2] === 'responder') { const C = lerC(s); const c = C.find((x) => x.id === b.id); if (c && (b.texto || anexos.length)) { c.msgs.push({ id: novoId('m'), de: 'dono', texto: String(b.texto || '').trim(), anexos, cita: b.cita || null, em: agora() }); c.resolvido = false; } gravarC(s, C); }
        else if (p[2] === 'escolher' && b.bloco) escolher(s, b.bloco, Array.isArray(b.marcados) ? b.marcados.map(Number).filter((n) => n >= 0 && n < 50) : []);
        else if (p[2] === 'resolver') { const C = lerC(s); const c = C.find((x) => x.id === b.id); if (c) { c.resolvido = !!b.resolvido; c.msgs.push({ de: 'sistema', texto: c.resolvido ? 'Comentário marcado como resolvido' : 'Comentário reaberto', em: agora() }); } gravarC(s, C); }
        else if (p[2] === 'editar' && b.md) { const d = lerD(s); const blk = d.blocos.find((x) => x.id === b.bloco); if (blk) { novaVersao(blk, b.md, 'dono', b.motivo || 'edição direta'); gravarD(s, d); } }
        else if (p[2] === 'restaurar') { const d = lerD(s); const blk = d.blocos.find((x) => x.id === b.bloco); const old = blk && blk.versoes.find((v) => v.v === b.v); if (old) { novaVersao(blk, old.md, 'dono', `restaurou a versão ${old.v}`); gravarD(s, d); } }
        json({ ok: true });
      });
    }
    if (p[0] === 'abrir-pasta') { // mostra o arquivo no Finder (só dentro da home)
      let f = path.resolve(String(u.searchParams.get('p') || '').replace(/^~/, os.homedir()));
      if (!f.startsWith(os.homedir()) || !fs.existsSync(f)) { res.writeHead(404); return res.end('não encontrado'); }
      abrirNoSO(f, !fs.statSync(f).isDirectory()); res.writeHead(200, { 'content-type': 'application/json' }); return res.end('{"ok":true}');
    }
    if (p[0] === 'ver') { // abre arquivo local (só leitura, dentro da home, nunca segredos)
      let f = String(u.searchParams.get('p') || '').replace(/^~/, os.homedir()); f = path.resolve(f);
      const proibido = /\/\.(secrets|ssh|gnupg|aws)(\/|$)|\.env$|id_rsa|\.pem$|\.key$/i.test(f);
      if (!f.startsWith(os.homedir()) || proibido || !fs.existsSync(f)) { res.writeHead(404, { 'content-type': 'text/plain; charset=utf-8' }); return res.end('arquivo não encontrado ou não permitido'); }
      if (fs.statSync(f).isDirectory()) { res.writeHead(200, { 'content-type': 'text/html; charset=utf-8' }); return res.end(`<meta charset="utf-8"><body style="font:15px Inter,sans-serif;padding:32px"><h3>${esc(f)}</h3>` + fs.readdirSync(f).map((n) => `<div><a href="/ver?p=${encodeURIComponent(path.join(f, n))}">${esc(n)}</a></div>`).join('')); }
      const ext = path.extname(f).toLowerCase(); const tipos = { '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.gif': 'image/gif', '.webp': 'image/webp', '.svg': 'image/svg+xml', '.pdf': 'application/pdf', '.html': 'text/html; charset=utf-8' };
      if (tipos[ext]) { res.writeHead(200, { 'content-type': tipos[ext] }); return res.end(fs.readFileSync(f)); }
      const txt = fs.readFileSync(f, 'utf8');
      const corpo = ext === '.md' ? dividir(txt).map((b) => render(b).html).join('\n') : `<pre style="white-space:pre-wrap;font:13.5px/1.55 ui-monospace,Menlo,monospace">${esc(txt)}</pre>`;
      res.writeHead(200, { 'content-type': 'text/html; charset=utf-8' });
      return res.end(`<!doctype html><meta charset="utf-8"><title>${esc(path.basename(f))}</title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Source+Serif+4:wght@700&display=swap" rel="stylesheet"><style>body{margin:0;background:#f6f5f1;font:16.5px/1.7 Inter,sans-serif;color:#1b2026}main{max-width:1100px;margin:24px auto;background:#fff;border:1px solid #e4e1da;border-radius:14px;padding:44px 72px}h1{font:700 36px/1.2 'Source Serif 4',serif}h2{font:700 25px/1.3 'Source Serif 4',serif;border-top:1px solid #e4e1da;padding-top:16px;margin-top:30px}.destaque{background:#e9f1f9;border-left:4px solid #1d63a6;border-radius:8px;padding:14px 20px}.li2{padding-left:30px}table{border-collapse:collapse;width:100%;font-size:15px}th,td{border-bottom:1px solid #eee;padding:8px 10px;text-align:left;vertical-align:top}th{background:#f3f2ee}code{background:#f1f0ec;padding:1px 5px;border-radius:4px}.cam{color:#5d6873;font-size:13px;margin-bottom:12px}</style><main><div class="cam">${esc(f)}</div>${corpo}</main>${ext === '.md' ? `<button id="pasta" style="position:fixed;top:16px;right:146px;z-index:9;border:1px solid #d6e2ef;border-radius:10px;padding:8px 14px;font:600 14px Inter,sans-serif;background:#fff;color:#1d63a6;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.08)">Abrir pasta</button><script>document.getElementById('pasta').onclick=()=>fetch('/abrir-pasta?p='+encodeURIComponent(${JSON.stringify(f)}))</script><button id="cp" style="position:fixed;top:16px;right:20px;z-index:9;border:0;border-radius:10px;padding:9px 16px;font:600 14px Inter,sans-serif;background:#1d63a6;color:#fff;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.15)">Copiar .md</button><textarea id="raw" hidden>${esc(txt)}</textarea><script>document.getElementById('cp').onclick=async()=>{const t=document.getElementById('raw').value;try{await navigator.clipboard.writeText(t)}catch(e){const a=document.getElementById('raw');a.hidden=false;a.select();document.execCommand('copy');a.hidden=true}const b=document.getElementById('cp');b.textContent='Copiado';b.style.background='#2f7d4f';setTimeout(()=>{b.textContent='Copiar .md';b.style.background='#1d63a6'},1500)}</script>` : ''}`);
    }
    if (p[0] === 'a' && slugs().includes(p[1]) && /^[\w.-]+$/.test(p[2] || '')) { const f = path.join(dir(p[1]), 'anexos', p[2]); if (fs.existsSync(f)) { res.writeHead(200, { 'content-type': 'image/' + (p[2].endsWith('.png') ? 'png' : p[2].endsWith('.gif') ? 'gif' : p[2].endsWith('.webp') ? 'webp' : 'jpeg') }); return res.end(fs.readFileSync(f)); } }
    if (p[0] === '__teste.js') { const f = path.join(os.tmpdir(), 'doc-comentavel-teste.js'); res.writeHead(200, { 'content-type': 'text/javascript' }); return res.end(fs.existsSync(f) ? fs.readFileSync(f) : ''); }
    if (p[0] && slugs().includes(p[0])) { res.writeHead(200, { 'content-type': 'text/html; charset=utf-8' }); return res.end(fs.readFileSync(PAGINA_F, 'utf8').replace('__SLUG__', JSON.stringify(p[0])).replace('__TITULO__', esc(lerD(p[0]).titulo))); }
    if (!p[0]) { res.writeHead(200, { 'content-type': 'text/html; charset=utf-8' }); return res.end('<meta charset="utf-8"><body style="font:16px Inter,sans-serif;padding:40px"><h2>Documentos</h2>' + slugs().map((x) => `<p><a href="/${x}">${esc(lerD(x).titulo)}</a></p>`).join('')); }
    res.writeHead(404); res.end('não encontrado');
  }).listen(porta, '127.0.0.1', () => console.log(`doc-comentavel v2 em http://localhost:${porta}`));
}

const args = process.argv.slice(2); const [cmd, a, b, c] = args;
const opt = (n) => { const i = args.indexOf('--' + n); return i >= 0 ? args[i + 1] : ''; };
const conteudo = (x) => x && x.startsWith('@') ? fs.readFileSync(x.slice(1), 'utf8') : x;
if (cmd === 'servir') servir(Number(a) || PORTA);
else if (cmd === 'publicar') {
  if (lerD(a) && !args.includes('--forcar')) { console.log('já existe; use editar/inserir, ou --forcar'); process.exit(1); }
  const md = fs.readFileSync(b, 'utf8'); fs.mkdirSync(dir(a), { recursive: true });
  const partes = dividir(md); const titulo = (partes[0].match(/^# (.*)/) || [, a])[1];
  const d = { titulo, origem: path.resolve(b), criadoEm: agora(), blocos: partes.map((x) => { const blk = { id: novoId('b'), versoes: [] }; novaVersao(blk, x, 'claude', 'versão inicial'); return blk; }) };
  gravarD(a, d); if (!fs.existsSync(path.join(dir(a), 'comentarios.json'))) gravarC(a, []);
  console.log(`publicado: http://localhost:${PORTA}/${a} (${d.blocos.length} blocos)`);
} else if (cmd === 'blocos') { for (const x of lerD(a).blocos) console.log(`${x.id}${x.oculto ? ' (oculto)' : ''} v${x.versoes.at(-1).v}  ${x.versoes.at(-1).md.replace(/\s+/g, ' ').slice(0, 90)}`); }
else if (cmd === 'bloco') { const x = lerD(a).blocos.find((y) => y.id === b); console.log(x ? x.versoes.at(-1).md : 'não encontrado'); }
else if (cmd === 'editar') { const d = lerD(a); const blk = d.blocos.find((y) => y.id === b); if (!blk) { console.log('bloco não encontrado'); process.exit(1); } const v = novaVersao(blk, conteudo(c), 'claude', opt('motivo'), opt('comentario')); gravarD(a, d); avisarFio(a, opt('comentario'), `Alterei o bloco (versão ${v})${opt('motivo') ? ': ' + opt('motivo') : ''}.`); console.log(`bloco ${b} agora na versão ${v}`); }
else if (cmd === 'inserir') { const d = lerD(a); const k = d.blocos.findIndex((y) => y.id === b); const blk = { id: novoId('b'), versoes: [] }; novaVersao(blk, conteudo(c), 'claude', opt('motivo') || 'bloco novo', opt('comentario')); d.blocos.splice(k + 1, 0, blk); gravarD(a, d); avisarFio(a, opt('comentario'), `Inseri um bloco novo${opt('motivo') ? ': ' + opt('motivo') : ''}.`); console.log('inserido', blk.id); }
else if (cmd === 'remover') { const d = lerD(a); const blk = d.blocos.find((y) => y.id === b); blk.oculto = true; novaVersao(blk, blk.versoes.at(-1).md, 'claude', 'ocultado: ' + (opt('motivo') || ''), opt('comentario')); gravarD(a, d); avisarFio(a, opt('comentario'), `Ocultei o bloco (continua no histórico)${opt('motivo') ? ': ' + opt('motivo') : ''}.`); console.log('ocultado'); }
else if (cmd === 'pendentes') { for (const s of a ? [a] : slugs()) { const d = lerD(s); for (const x of lerC(s)) if (!x.resolvido && x.msgs.at(-1).de === 'dono') { const blk = d.blocos.find((y) => y.id === x.bloco); console.log(`[${s}] comentario=${x.id} bloco=${x.bloco} (v${blk ? blk.versoes.at(-1).v : '?'})\n  seleção: ${x.trecho || '(bloco inteiro)'}\n  pedido: ${x.msgs.filter((m) => m.de === 'dono').at(-1).texto}\n${(() => { const u = x.msgs.filter((m) => m.de === 'dono').at(-1); if (!u.cita) return ''; const f = lerC(s).find((y) => y.id === u.cita.fio); const m = f && (f.msgs.find((z) => z.id === u.cita.msg) || f.msgs[Number(u.cita.msg)]); return m ? `  citando (${m.de === 'dono' ? 'ele' : 'você'}): ${String(m.texto).slice(0, 200)}\n` : ''; })()}${x.msgs.filter((m) => m.de === 'dono').flatMap((m) => m.anexos || []).map((a) => '  imagem: ' + a.caminho + '\n').join('')}  texto atual do bloco:\n${blk ? blk.versoes.at(-1).md.split('\n').map((l) => '    ' + l).join('\n') : ''}\n`); } } }
else if (cmd === 'responder') { const t = conteudo(args.slice(2).filter((v, i, arr) => v !== '--cita' && arr[i - 1] !== '--cita').join(' ')); for (const s of slugs()) { const C = lerC(s); const x = C.find((y) => y.id === a); if (x) { x.msgs.push({ id: novoId('m'), de: 'claude', texto: t.trim(), cita: opt('cita') ? { fio: x.id, msg: opt('cita') } : null, em: agora() }); gravarC(s, C); console.log('respondido'); process.exit(0); } } console.log('comentário não encontrado'); }
else if (cmd === 'escolhas') { const d = lerD(a); const E = lerE(a); let n = 0; for (const blk of d.blocos.filter((b) => !b.oculto)) { const ops = opcoes(blk.versoes.at(-1).md); if (!ops.length) continue; n++; const e = E[blk.id]; console.log(`${blk.id}  ${tituloPergunta(d, blk.id) || '(sem título)'}  ${e ? 'respondida em ' + e.em.slice(0, 16).replace('T', ' ') : 'SEM RESPOSTA'}`); ops.forEach((o, k) => console.log(`   ${(e ? e.marcados.includes(k) : o.pre) ? '[x]' : '[ ]'} ${limpo(o.texto)}${!e && o.pre ? '  (marcada de saída)' : ''}`)); } if (!n) console.log('nenhuma pergunta de escolha neste documento'); }
else if (cmd === 'resolver') { for (const s of slugs()) { const C = lerC(s); const x = C.find((y) => y.id === a); if (x) { x.resolvido = true; gravarC(s, C); console.log('resolvido'); } } }
else if (cmd === 'esperar') { const conta = () => slugs().reduce((n, s) => n + lerC(s).filter((x) => !x.resolvido && x.msgs.at(-1).de === 'dono').length, 0); const base = conta(); const fim = Date.now() + (Number(a) || 3500) * 1000; const t = setInterval(() => { const n = conta(); if (n > base || (n > 0 && base === 0)) { clearInterval(t); console.log(`comentário novo (${n} pendentes)`); process.exit(0); } if (Date.now() > fim) { clearInterval(t); console.log('tempo esgotado'); process.exit(0); } }, 2500); }
else console.log(fs.readFileSync(__filename, 'utf8').split('\n').slice(1, 20).join('\n'));
